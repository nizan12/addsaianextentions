{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/index.php",
      "destination": "/api/server.js"
    },
    {
      "source": "/api",
      "destination": "/api/server.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
